      "name": "setTime",
      "arguments": [
        {
          "name": "time",
          "optional": false,
          "schema": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          }
        }
      ]
    }
  }
}